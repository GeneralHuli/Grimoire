# Copy to .env and fill in. See docs/setup/google-account.md for how to get these.

PORT=3000
DB_PATH=./data/grimoire.sqlite

# Any random string works — used to derive the AES key for encrypting secrets at rest
# (e.g. the Google refresh token). Generate one with: openssl rand -hex 32
GRIMOIRE_ENCRYPTION_KEY=

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, "Web
# application"). These identify the Grimoire app itself, not any user — safe to store
# as a static k8s Secret. The actual per-account refresh token never lives here; it's
# obtained via the in-app "Sign in with Google" flow and stored encrypted in SQLite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/spells/google-account/auth/callback

# From console.anthropic.com > API Keys. Powers the Recipes Spell's "Generate with AI"
# feature. Recipes works fine without this — AI generation just returns an error until
# it's set; manual entry and URL import don't need it.
ANTHROPIC_API_KEY=

# From developer.kroger.com > your app's registration. Identify the Grimoire app itself
# to Kroger's Public API (Fred Meyer is one of the Kroger family banners) — safe to
# store as a static k8s Secret, same as the Google credentials above. See
# docs/setup/kroger.md for how to get these. The shopper's own cart access token is a
# separate matter: obtained via the in-app "Connect Fred Meyer" flow and stored
# encrypted in SQLite, never here.
#
# Redirect URI points at :5173 (the Vite dev server), not :3000 like Google's above —
# the browser is normally on :5173 the whole session, and Vite's dev proxy already
# forwards /api/* (including this callback) to the :3000 server. Landing the final
# redirect on :3000 directly would leave the browser on a bare API origin with no
# frontend route to show, which is a dead end (this bit Kroger in testing; harmless for
# Google today only because nothing currently notices the same dead end after it).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:5173/api/spells/retail-kroger/auth/callback
