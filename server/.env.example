# Copy to .env and fill in. See docs/setup/google-calendar.md for how to get these.

PORT=3000
DB_PATH=./data/grimoire.sqlite

# Any random string works — used to derive the AES key for encrypting secrets at rest
# (e.g. the Google refresh token). Generate one with: openssl rand -hex 32
GRIMOIRE_ENCRYPTION_KEY=

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/spells/calendar/auth/callback
