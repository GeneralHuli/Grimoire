# Copy to .env and fill in. See docs/setup/google-account.md for how to get these.

PORT=3000
DB_PATH=./data/grimoire.sqlite

# Any random string works — used to derive the AES key for encrypting secrets at rest
# (e.g. the Google refresh token). Generate one with: openssl rand -hex 32
GRIMOIRE_ENCRYPTION_KEY=

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, "Web
# application"). These identify the Grimoire app itself, not any user — safe to store
# as a static k8s Secret. The actual per-account refresh token never lives here; it's
# obtained via the in-app "Sign in with Google" flow and stored encrypted in SQLite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/spells/google-account/auth/callback

# From console.anthropic.com > API Keys. Powers the Recipes Spell's "Generate with AI"
# feature. Recipes works fine without this — AI generation just returns an error until
# it's set; manual entry and URL import don't need it.
ANTHROPIC_API_KEY=
